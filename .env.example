# Required before enabling paid checkout; set agreed monthly analysis allowances.
CPGIST_PRO_MONTHLY_AI_LIMIT=300
CPGIST_GROWTH_MONTHLY_AI_LIMIT=1500

# Server-side Supabase admin credential. Never use in NEXT_PUBLIC_* variables.
